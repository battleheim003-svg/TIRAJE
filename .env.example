# ─── Database ───────────────────────────────────────────────────────────────
POSTGRES_USER=tirajeh
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=tirajeh_db
DATABASE_URL="postgresql://tirajeh:your_strong_password_here@localhost:5432/tirajeh_db"

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=your_redis_password_here
REDIS_URL="redis://:your_redis_password_here@localhost:6379"

# ─── Auth.js ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=https://tirajeh.ir

# Admin panel URL (used by admin app)
ADMIN_URL=https://admin.tirajeh.ir

# ─── Object Storage (MinIO / Liara) ──────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_BUCKET=tirajeh
S3_REGION=ir-thr-at1
S3_PUBLIC_URL=https://storage.tirajeh.ir

# MinIO (local dev)
MINIO_ROOT_USER=tirajeh_minio
MINIO_ROOT_PASSWORD=your_minio_password_here

# ─── Payment ─────────────────────────────────────────────────────────────────
ZARINPAL_MERCHANT_ID=your_zarinpal_merchant_id
ZARINPAL_SANDBOX=false

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
# ایمیل تأیید سفارش از این آدرس ارسال میشود
FROM_EMAIL=noreply@yourdomain.com
EMAIL_FROM=info@tirajeh.ir

# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret
# برای relay تلگرام (اختیاری — اگر Liara مستقیم بلاک است)
TELEGRAM_API_ROOT=
# آیدی چت خصوصی مدیر در تلگرام (برای اعلانها)
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id
TELEGRAM_ADMIN_USER_ID=your_telegram_numeric_user_id   # برای امنیت — فقط این user میتواند /price بزند
TELEGRAM_CHANNEL_ID=your_public_channel_numeric_id      # مثل -1001234567890
TELEGRAM_CHANNEL_USERNAME=@TirajehConcrete               # نام کاربری کانال تلگرام برای درج در کارت قیمت و پست‌ها
NEXT_PUBLIC_TELEGRAM_CHANNEL_USERNAME=@TirajehConcrete   # برای مقدار پیش‌فرض فرم‌های ادمین
TELEGRAM_SUPPORT_CHAT_ID=your_support_group_or_topic_id  # می‌تواند همان ADMIN_CHAT_ID باشد
SUPPORT_USE_FORUM_TOPICS=false
SITE_URL=https://tirajeconcrete.com                      # آدرس سایت جهت تولید لینک دکمه‌ها و فچ کارت قیمت
SITE_PHONE=021-XXXXXXXX                                  # شماره تماس رسمی پشتیبانی و سفارش جهت درج در کارت قیمت و کپشن تلگرام

# ─── Seed ────────────────────────────────────────────────────────────────────
SEED_SUPER_ADMIN_PASSWORD=changeme123!

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
\nZARINPAL_MERCHANT_ID=\nZARINPAL_SANDBOX=true\n
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
